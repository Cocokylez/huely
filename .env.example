# Supabase — from your project's Settings → API keys.
# Without these, Huely runs in guest mode (local IndexedDB history, no accounts).
# The publishable key (sb_publishable_…) is the renamed anon key; either var name works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key-also-supported
